{
  "id": "sky-forage",
  "name": "Sky Forage",
  "status": "ready",
  "install": "install.sh",
  "uninstall": "uninstall.sh",
  "nested_features": true,
  "features": [
    "sky",
    "cameraOverlay",
    "forage",
    "wildFoodSafety",
    "offlineTrailPack",
    "offlineSkyPack",
    "networkOnlyLabels"
  ],
  "offline_safe": true,
  "installed_marker": "/var/lib/mappi3/plugins/sky-forage/installed.json",
  "offline_pack_root": "/var/lib/mappi3/offline-packs/sky-forage",
  "description": "Sky/forage guide storage plus a compact offline trail/sky starter pack. Live public APIs stay network-only unless cached/precomputed."
}
